{
  "title": "app-cicd — SLOs",
  "tags": ["slo", "app-cicd", "appcicd-dev"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilidad actual (1m)",
      "description": "Tasa de respuestas 2xx / total. Objetivo: >= 99.5%",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green", "value": 0.995 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "expr": "app_cicd:success_ratio:rate1m", "legendFormat": "Disponibilidad", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tasa de errores actual (1m)",
      "description": "Tasa de respuestas 5xx / total. Objetivo: <= 0.5%",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.05,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.003 },
              { "color": "red", "value": 0.005 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "expr": "app_cicd:error_ratio:rate1m", "legendFormat": "Errores 5xx", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Latencia p95 actual (1m)",
      "description": "histogram_quantile(0.95). Objetivo: <= 500ms",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "expr": "app_cicd:http_request_duration:p95", "legendFormat": "p95", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SLO 1 - Disponibilidad (2xx/total) vs objetivo 99.5%",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0.9, "max": 1 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "app_cicd:success_ratio:rate1m", "legendFormat": "Disponibilidad real", "refId": "A" },
        { "expr": "0.995", "legendFormat": "Objetivo (99.5%)", "refId": "B" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "SLO 2 - Tasa de errores 5xx vs limite 0.5%",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "app_cicd:error_ratio:rate1m", "legendFormat": "Tasa de errores real", "refId": "A" },
        { "expr": "0.005", "legendFormat": "Limite (0.5%)", "refId": "B" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SLO 3 - Latencia p95 vs limite 500ms",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "app_cicd:http_request_duration:p95", "legendFormat": "Latencia p95 real", "refId": "A" },
        { "expr": "0.5", "legendFormat": "Limite (500ms)", "refId": "B" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Trafico - requests/s por codigo de respuesta",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (code) (rate(http_requests_received_total{job=\"app-cicd\"}[1m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ]
    }
  ]
}